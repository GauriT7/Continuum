# Copy the relevant values into Vercel Project Settings > Environment Variables.
# Never commit real secrets or copy a production .env file into Git.

# Supabase — browser anon key is public; service-role key is server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# LiveKit browser voice — server-only credentials; never use a VITE_ prefix.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
LIVEKIT_AGENT_NAME=continuum-appointment-reminder

# Existing Sarvam Model APIs (STT/TTS/translation/LLM/Document AI).
# The same Sarvam account API key can authenticate Sarvam API endpoints;
# Voice Agent requests use X-API-Key and are sent only from the Vercel backend.
SARVAM_API_KEY=YOUR_SARVAM_API_KEY
# Optional explicit alias; when present it takes precedence over SARVAM_API_KEY.
SARVAM_VOICE_API_KEY=

# Outbound campaign calling — keep OFF until deployment, telephony, webhook,
# scheduler, tests and clinic sign-off are complete.
VOICE_DISPATCH_ENABLED=false
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
VOICE_WEBHOOK_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_CAMPAIGN_ID=
SARVAM_CAMPAIGN_WEBHOOK_CONFIGURED=false
VOICE_DISPATCH_SCHEDULER_CONFIGURED=false

# Instant single-recipient Sarvam Voice Agent — keep OFF until connection + callback + test are verified.
VOICE_INSTANT_CALLS_ENABLED=false
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=+91XXXXXXXXXX
SARVAM_CONNECTION_VERIFIED=false
VOICE_AGENT_WEBHOOK_SECRET=REPLACE_WITH_A_DIFFERENT_32_PLUS_CHARACTER_SECRET
# Optional: stable production HTTPS origin; Vercel URL variables are fallback.
PUBLIC_BASE_URL=https://your-continuum-domain.example
SARVAM_CONTEXT_STRATEGY=agent_variables
# Only needed when SARVAM_CONTEXT_STRATEGY=on_start_hook.
VOICE_CONTEXT_HOOK_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Comma-separated clinic/public holidays in YYYY-MM-DD format (IST).
CALLING_HOLIDAYS=

# Optional staff-account Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR_OPERATIONS_EMAIL

# Demo-only: caps the displayed clinic roster to three people.
CONTINUUM_DEMO_MODE=true

# ABDM: status-only readiness check; these values do NOT activate a live HIU/HIP exchange.
ABDM_SANDBOX_CLIENT_ID=
ABDM_SANDBOX_CLIENT_SECRET=
ABDM_CM_ID=
