# Copy the relevant values into Vercel Project Settings > Environment Variables.
# Never commit real secrets or copy a production .env file into Git.

# Existing Supabase app configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Existing Sarvam AI features in Operations Centre (STT/TTS/translation/LLM/Document AI)
SARVAM_API_KEY=YOUR_SARVAM_API_KEY

# Optional staff-account Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR_OPERATIONS_EMAIL

# Demo-only: caps the displayed clinic roster to three people
CONTINUUM_DEMO_MODE=true

# Outbound voice: KEEP FALSE until the draft agent, clinic workflow, Exotel connection,
# webhook authentication, holiday dates and 22 test cases are signed off.
VOICE_DISPATCH_ENABLED=false
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
VOICE_WEBHOOK_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
SARVAM_VOICE_API_KEY=YOUR_SARVAM_VOICE_AGENT_API_KEY
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_CAMPAIGN_ID=

# ABDM: status-only readiness check for now. These values do NOT activate a live HIU/HIP exchange.
ABDM_SANDBOX_CLIENT_ID=
ABDM_SANDBOX_CLIENT_SECRET=
ABDM_CM_ID=


# ---------------------------------------------------------------------------
# Single-recipient Sarvam Voice Agent (separate from the legacy cohort campaign)
# Keep live calling disabled until the Sarvam agent, phone connection, webhook,
# consent flow and clinic testing have all been verified.
VOICE_INSTANT_CALLS_ENABLED=false
VOICE_AGENT_WEBHOOK_SECRET=REPLACE_WITH_A_DIFFERENT_32_PLUS_CHARACTER_SECRET
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=+91XXXXXXXXXX
SARVAM_CONTEXT_STRATEGY=agent_variables
# Only needed when SARVAM_CONTEXT_STRATEGY=on_start_hook
VOICE_CONTEXT_HOOK_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
# Set to the production Continuum HTTPS origin (not localhost).
PUBLIC_BASE_URL=https://your-continuum-domain.example
# Comma-separated YYYY-MM-DD holidays in IST, reviewed by the clinic.
CALLING_HOLIDAYS=
